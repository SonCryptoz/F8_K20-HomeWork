{
    "rewrites": [
        {
            "source": "/login(.*)",
            "destination": "/src/pages/Login/index.html"
        },
        {
            "source": "/register(.*)",
            "destination": "/src/pages/Register/index.html"
        },
        {
            "source": "/src/pages/login(.*)",
            "destination": "/src/pages/Login/index.html"
        },
        {
            "source": "/src/pages/register(.*)",
            "destination": "/src/pages/Register/index.html"
        },
        {
            "source": "/:path*",
            "destination": "/index.html"
        }
    ]
}
